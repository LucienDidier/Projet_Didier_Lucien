{
  "name": "ex01",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "concurrently --names API,Angular \"npm:mock:api\" \"npm:serve:dev\"",
    "serve:dev": "wait-on http://localhost:3000/pollutions && ng serve",
    "mock:api": "json-server --watch db.json --port 3000",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "dependencies": {
