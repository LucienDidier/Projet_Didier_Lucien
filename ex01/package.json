{
  "name": "ex01",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "concurrently --kill-others-on-fail --names API,Angular \"npm:api:dev\" \"npm:serve:dev\"",
    "api:dev": "npm --prefix api run dev",
    "serve:dev": "wait-on --timeout 15000 http://localhost:3000/health && ng serve",
    "build": "ng build",
    "build:render": "node scripts/write-render-environment.mjs && ng build --configuration render",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "concurrently": "^10.0.6",
    "jsdom": "^30.0.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "wait-on": "^9.5.1"
  }
}
